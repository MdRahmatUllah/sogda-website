{
  "name": "sogda-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/strip-next.mjs && node scripts/csp.mjs",
    "start": "serve out -l 4173",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "sync:brand": "node scripts/sync-brand.mjs",
    "sync:screens": "node scripts/sync-screenshots.mjs",
    "sync:facts": "node scripts/sync-facts.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "og": "node scripts/og.mjs",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "lucide-react": "1.48.0",
    "next": "15.5.26",
    "next-intl": "4.14.8",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chrome-launcher": "1.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.26",
    "lighthouse": "13.5.0",
    "prettier": "3.9.9",
    "serve": "14.2.6",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
